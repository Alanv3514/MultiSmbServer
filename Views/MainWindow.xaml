<Window x:Class="MultiSmbServer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MultiSmbServer.Views"
        xmlns:vm="clr-namespace:MultiSmbServer.ViewModels"
        mc:Ignorable="d"
        Title="Multi SMB Server"
        Height="680" Width="880"
        MinHeight="580" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="#16161E"
        Foreground="#D8D8E4"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9A9AB0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#232330"/>
            <Setter Property="Foreground" Value="#E8E8F4"/>
            <Setter Property="BorderBrush" Value="#3A3A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="CaretBrush" Value="#E8E8F4"/>
            <Setter Property="SelectionBrush" Value="#5B8DEF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5B8DEF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#232330"/>
            <Setter Property="Foreground" Value="#E8E8F4"/>
            <Setter Property="BorderBrush" Value="#3A3A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="CaretBrush" Value="#E8E8F4"/>
            <Setter Property="SelectionBrush" Value="#5B8DEF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5B8DEF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E8E8F4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="8,5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#34344A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D5A98"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#232330"/>
            <Setter Property="Foreground" Value="#E8E8F4"/>
            <Setter Property="BorderBrush" Value="#3A3A4A"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"/>
                            <ToggleButton x:Name="Toggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path HorizontalAlignment="Right"
                                                  Margin="0,0,10,0"
                                                  VerticalAlignment="Center"
                                                  Data="M 0,0 L 8,0 L 4,5 Z"
                                                  Fill="#9A9AB0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="220"
                                        Margin="0,2,0,0"
                                        Background="#1E1E2A"
                                        BorderBrush="#3A3A4A"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D8D8E4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box"
                                    Width="16" Height="16"
                                    VerticalAlignment="Center"
                                    Background="#232330"
                                    BorderBrush="#3A3A4A"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                <Path x:Name="Check"
                                      Data="M 3,8 L 6,11 L 12,4"
                                      Stroke="#7AA2F7"
                                      StrokeThickness="2"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#7AA2F7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#5B8DEF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6FA0FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A7BDB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#30303E"/>
                                <Setter Property="Foreground" Value="#6E6E82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2A3A"/>
            <Setter Property="Foreground" Value="#D8D8E4"/>
            <Setter Property="BorderBrush" Value="#3A3A4A"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#34344A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26263A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Multi SMB Server" FontSize="20" FontWeight="SemiBold" Foreground="#E8E8F4"/>
            <TextBlock Text="Servidor SMBv1 (NT LM 0.12) para consolas retro: PS2, Wii y GameCube" FontSize="12" Foreground="#8888A0" Margin="0,2,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#1C1C28" BorderBrush="#2E2E3E" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid IsEnabled="{Binding IsStopped}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Shares" Foreground="#9A9AB0" Margin="0,0,0,6"/>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding Shares}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ShareEntry}">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Style="{StaticResource FormTextBox}"
                                         ToolTip="Nombre del share"
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource FormTextBox}"
                                         ToolTip="Carpeta a compartir"
                                         Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="2"
                                        Content="Examinar..."
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding DataContext.BrowseShareCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Margin="6,0,0,0"/>
                                <Button Grid.Column="3"
                                        Content="✕"
                                        Style="{StaticResource SecondaryButton}"
                                        ToolTip="Quitar share"
                                        Command="{Binding DataContext.RemoveShareCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Width="30"
                                        Margin="6,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Grid.Row="2"
                        Content="+ Agregar share"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left"
                        Command="{Binding AddShareCommand}"
                        Margin="0,0,0,12"/>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Puerto de escucha"/>
                    <TextBox Style="{StaticResource FormTextBox}"
                             Width="120"
                             Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="(445 = Direct TCP, 139 = NetBIOS, o un puerto personalizado)"
                               Foreground="#7A7A92"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Usuario"/>
                    <TextBox Style="{StaticResource FormTextBox}"
                             Width="220"
                             HorizontalAlignment="Left"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Contraseña" Margin="20,0,10,0"/>
                    <PasswordBox Style="{StaticResource FormPasswordBox}"
                                 Width="220"
                                 HorizontalAlignment="Left"
                                 local:PasswordBoxAssistant.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <CheckBox Grid.Row="5"
                          IsChecked="{Binding EnableGuest}"
                          Content="Permitir acceso Guest/Anónimo (recomendado: OPL suele conectar sin credenciales)"/>

                <CheckBox Grid.Row="6"
                          Margin="0,8,0,0"
                          IsChecked="{Binding LanOnly}"
                          Content="Solo aceptar conexiones de la red local (LAN). Recomendado para no exponer el servidor a Internet."/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,14,0,14">
            <TextBlock DockPanel.Dock="Right"
                       Text="{Binding StatusText}"
                       Foreground="#8888A0"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Iniciar servidor"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding StartCommand}"
                        IsEnabled="{Binding IsStopped}"/>
                <Button Content="Detener servidor"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding StopCommand}"
                        IsEnabled="{Binding IsRunning}"
                        Margin="8,0,0,0"/>
                <Button Content="Guardar configuración"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding SaveSettingsCommand}"
                        Margin="8,0,0,0"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Registro de actividad" Foreground="#9A9AB0" Margin="0,0,0,6"/>

            <TextBox Grid.Row="1"
                     x:Name="LogBox"
                     Text="{Binding LogText, Mode=OneWay}"
                     IsReadOnly="True"
                     TextWrapping="NoWrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="12"
                     Background="#12121A"
                     Foreground="#B8E0B8"
                     BorderBrush="#2E2E3E"
                     BorderThickness="1"
                     CaretBrush="#B8E0B8"
                     Padding="8">
                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </TextBox.Template>
            </TextBox>
        </Grid>
    </Grid>
</Window>
